# Archipelago Agents - Example Configuration
# Copy this file to .env and fill in values as needed

# Environment type: local, dev, prod
ENV=local

# Agent execution timeout (in seconds, default 22 hours 30 minutes)
AGENT_TIMEOUT_SECONDS=81000

# Set to false to fail instead of assuming 128k tokens when a model's context
# window is unknown (always the case for openrouter/ models). With false, set
# context_window_tokens in the agent config for every model.
# CONTEXT_WINDOW_FALLBACK_ENABLED=true

# =============================================================================
# LLM Provider API Keys (at least one required)
# =============================================================================
# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# OpenRouter (one key for many providers; model strings like openrouter/<vendor>/<model>)
OPENROUTER_API_KEY=

# OR route every LLM call through a LiteLLM proxy. With both set, model strings
# are the proxy's aliases (e.g. litellm_proxy/<alias>, or a bare alias), and the
# startup check asks the proxy (GET /v1/models) whether the key works and each
# model's alias is served, instead of checking provider keys the proxy holds.
# LITELLM_PROXY_CHECK_MODELS=false skips the alias part, for aliases the proxy
# routes but doesn't list.
# LITELLM_PROXY_API_BASE=
# LITELLM_PROXY_API_KEY=

# =============================================================================
# Logging backends (all optional)
# =============================================================================
# File logging
FILE_LOGGING=false
FILE_LOG_PATH=

# Redis logging (for real-time streaming)
# REDIS_LOGGING=false
# REDIS_HOST=
# REDIS_PORT=6379

# Datadog APM
# DATADOG_LOGGING=false
# DATADOG_API_KEY=
